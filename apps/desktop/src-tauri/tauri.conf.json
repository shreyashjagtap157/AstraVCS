{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AstraVCS",
  "version": "0.37.0",
  "identifier": "dev.astravcs.desktop",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:* https:; script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'"
    },
    "windows": [
      {
        "title": "AstraVCS",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
