# AstraVCS repository line-ending policy.
# The catch-all text normalization is declared FIRST so that specific
# byte-exact fixtures declared below take precedence (later lines win).
* text=auto

# Canonical fixture files that encode exact byte contracts (repository format
# descriptors, bundle/snapshot archives, canonical vector corpora) must never
# be line-normalized by Git, otherwise Windows checkouts corrupt them and
# break byte-exact conformance assertions. Mark them binary so their stored
# bytes are preserved verbatim on every platform regardless of core.autocrlf.
tests/fixtures/**/*.zip      -text
tests/fixtures/**/*.astra    -text
tests/fixtures/format1/format -text
tests/vectors/*.tsv          -text
